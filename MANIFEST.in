include README.md
include LICENSE
include pyproject.toml
recursive-include src/careeros *.json
recursive-include docs *.md
recursive-include requirements *.txt
recursive-include tests *.py *.json
recursive-include fixtures/synthetic *.json *.md
prune build
prune dist
prune .venv
global-exclude *.pyc
global-exclude __pycache__
global-exclude .DS_Store
include SKILL.md CONTRIBUTING.md SECURITY.md CHANGELOG.md
recursive-include skills *.md *.py *.json *.yaml
recursive-include scripts *.py
recursive-include .github *.yml
recursive-include docs/images *.png
recursive-include examples *.md *.json *.yaml *.pdf *.docx *.html

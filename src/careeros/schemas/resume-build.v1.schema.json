{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:careeros:schema:resume-build:v1",
  "title":"ResumeBuildV1","type":"object","additionalProperties":false,
  "required":["schema","schema_version","build_id","profile_hash","opportunity_id","jd_snapshot_hash","role_family_id","qualification_id","compiler_version","policy_versions","template_version","font_profile_version","input_evidence_ids","selected_evidence_ids","excluded_evidence","gate_state","created_at","canonical_evidence_freshness"],
  "properties":{
    "schema":{"const":"careeros.resume-build.v1"},"schema_version":{"const":"1.0.0"},"build_id":{"type":"string","minLength":3},
    "profile_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"opportunity_id":{"type":"string"},"jd_snapshot_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "role_family_id":{"type":"string"},"qualification_id":{"type":"string"},"compiler_version":{"type":"string"},
    "policy_versions":{"type":"object"},"template_version":{"type":"string"},"font_profile_version":{"type":"string"},
    "input_evidence_ids":{"type":"array","items":{"type":"string"}},"selected_evidence_ids":{"type":"array","items":{"type":"string"}},
    "excluded_evidence":{"type":"array","items":{"type":"object"}},"gate_state":{"enum":["BUILDING","VALIDATING","PASSED","FAILED"]},
    "created_at":{"type":"string","format":"date-time"},
    "lane_base_id":{"type":["string","null"]},
    "canonical_evidence_freshness":{"$ref":"urn:careeros:schema:canonical-evidence-freshness:v1"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:careeros:schema:employment-record:v1",
  "title": "EmploymentRecordV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "record_id", "created_at", "updated_at", "provenance", "verification_state", "confidence", "visibility", "status", "employer", "actual_title", "employment_type", "start_year", "end_year", "date_precision", "evidence_ids", "claim_boundaries"],
  "properties": {
    "schema": {"const": "careeros.employment-record.v1"},
    "schema_version": {"const": "1.0.0"},
    "record_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "urn:careeros:schema:provenance-record:v1"}},
    "verification_state": {"enum": ["UNVERIFIED", "NEEDS_VERIFICATION", "VERIFIED", "DISPUTED"]},
    "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "visibility": {"enum": ["PRIVATE", "INTERNAL", "PUBLIC", "EMPLOYER_SAFE", "RESTRICTED"]},
    "status": {"enum": ["ACTIVE", "SUPERSEDED", "REJECTED"]},
    "supersedes_record_id": {"type": ["string", "null"]},
    "employer": {"type": "string", "minLength": 1},
    "actual_title": {"type": "string", "minLength": 1},
    "normalized_title": {"type": ["string", "null"]},
    "public_title": {"type": ["string", "null"]},
    "employment_type": {"type": "string", "minLength": 1},
    "location": {"type": ["string", "null"]},
    "start_month": {"type": ["string", "null"]},
    "start_year": {"type": ["integer", "string", "null"]},
    "end_month": {"type": ["string", "null"]},
    "end_year": {"type": ["integer", "string", "null"]},
    "date_precision": {"type": "string", "minLength": 1},
    "role_context": {"type": ["string", "null"]},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "claim_boundaries": {"type": "array", "items": {"type": "string"}}
  }
}

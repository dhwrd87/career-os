{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:careeros:schema:education-record:v1",
  "title": "EducationRecordV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "record_id", "created_at", "updated_at", "provenance", "verification_state", "confidence", "visibility", "status", "institution", "program", "completion_status", "claim_boundaries"],
  "properties": {
    "schema": {"const": "careeros.education-record.v1"},
    "schema_version": {"const": "1.0.0"},
    "record_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "urn:careeros:schema:provenance-record:v1"}},
    "verification_state": {"enum": ["UNVERIFIED", "NEEDS_VERIFICATION", "VERIFIED", "DISPUTED"]},
    "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "visibility": {"enum": ["PRIVATE", "INTERNAL", "PUBLIC", "EMPLOYER_SAFE", "RESTRICTED"]},
    "status": {"enum": ["ACTIVE", "SUPERSEDED", "REJECTED"]},
    "supersedes_record_id": {"type": ["string", "null"]},
    "institution": {"type": "string", "minLength": 1},
    "program": {"type": "string", "minLength": 1},
    "field_of_study": {"type": ["string", "null"]},
    "completion_status": {"type": "string", "minLength": 1},
    "start_year": {"type": ["integer", "string", "null"]},
    "end_year": {"type": ["integer", "string", "null"]},
    "claim_boundaries": {"type": "array", "items": {"type": "string"}}
  }
}

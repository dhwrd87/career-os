{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:careeros:schema:lane-base-resume:v1",
  "title": "LaneBaseResumeV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "lane_base_id", "candidate_profile_id", "role_family_id",
    "career_profile_hash", "storyline_id", "target_title_family", "positioning",
    "anchor_evidence_ids", "supporting_evidence_ids", "transferable_evidence_ids",
    "default_section_order", "default_project_order", "skill_groups", "allowed_claims",
    "prohibited_claims", "gap_assumptions", "compiler_version", "editorial_policy_version",
    "template_version", "build_id", "artifact_id", "status", "created_at", "updated_at", "supersedes", "canonical_evidence_freshness"
  ],
  "properties": {
    "schema": {"const": "careeros.lane-base-resume.v1"},
    "schema_version": {"const": "1.0.0"},
    "lane_base_id": {"type": "string", "minLength": 3},
    "candidate_profile_id": {"type": "string", "minLength": 3},
    "role_family_id": {"type": "string", "minLength": 3},
    "career_profile_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "storyline_id": {"type": "string", "minLength": 3},
    "target_title_family": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "positioning": {"type": "string", "minLength": 1},
    "anchor_evidence_ids": {"type": "array", "items": {"type": "string"}},
    "supporting_evidence_ids": {"type": "array", "items": {"type": "string"}},
    "transferable_evidence_ids": {"type": "array", "items": {"type": "string"}},
    "default_section_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "default_project_order": {"type": "array", "items": {"type": "string"}},
    "skill_groups": {"type": "array", "items": {"type": "object"}},
    "allowed_claims": {"type": "array", "items": {"type": "string"}},
    "prohibited_claims": {"type": "array", "items": {"type": "string"}},
    "gap_assumptions": {"type": "array", "items": {"type": "string"}},
    "compiler_version": {"type": "string", "minLength": 1},
    "editorial_policy_version": {"type": "string", "minLength": 1},
    "template_version": {"type": "string", "minLength": 1},
    "build_id": {"type": "string", "minLength": 3},
    "artifact_id": {"type": "string", "minLength": 3},
    "status": {"enum": ["PROPOSED", "REVIEW_REQUIRED", "ACCEPTED", "STALE", "SUPERSEDED", "REJECTED"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "supersedes": {"type": ["string", "null"]},
    "canonical_evidence_freshness":{"$ref":"urn:careeros:schema:canonical-evidence-freshness:v1"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:careeros:schema:canonical-changeset:v1",
  "title": "CanonicalChangeSetV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "changeset_id", "candidate_profile_id", "created_at", "created_by", "source", "reason", "proposed_changes", "affected_records", "affected_derivatives", "conflicts", "clarifications", "expected_canonical_revision", "expected_canonical_hash", "changeset_hash", "approval_state", "approved_at", "commit_event_id"],
  "properties": {
    "schema": {"const": "careeros.canonical-changeset.v1"},
    "schema_version": {"const": "1.0.0"},
    "changeset_id": {"type": "string", "pattern": "^changeset:[A-Za-z0-9-]+$"},
    "candidate_profile_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string", "minLength": 1},
    "source": {"type": "object"},
    "reason": {"type": "string", "minLength": 1},
    "proposed_changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation", "record_type", "record_id", "field_path", "before", "after", "source_refs", "confidence", "visibility_impact", "verification_impact", "reason", "expected_record_hash", "expected_collection_hash"],
        "properties": {
          "operation": {"enum": ["ADD_RECORD", "CORRECT_FACT", "REFINE_APPROXIMATE_FACT", "ADD_EVIDENCE", "CHANGE_VERIFICATION_STATE", "CHANGE_VISIBILITY", "SUPERSEDE_RECORD", "ADD_METRIC", "CORRECT_METRIC", "UPDATE_CREDENTIAL_STATE", "UPDATE_SKILL_STATE", "ADD_PROJECT", "UPDATE_PROJECT_CONTRIBUTION", "CHANGE_CAREER_PREFERENCE", "CHANGE_ROLE_TARGET"]},
          "record_type": {"enum": ["candidate", "employment", "education", "skills", "credentials", "evidence", "projects", "preferences"]},
          "record_id": {"type": ["string", "null"]},
          "field_path": {"type": ["string", "null"]},
          "before": {},
          "after": {},
          "source_refs": {"type": "array", "items": {"type": "string"}},
          "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
          "visibility_impact": {"enum": ["NONE", "LESS_RESTRICTIVE", "MORE_RESTRICTIVE", "UNKNOWN"]},
          "verification_impact": {"enum": ["NONE", "UPGRADE", "DOWNGRADE", "DISPUTED", "UNKNOWN"]},
          "reason": {"type": "string", "minLength": 1},
          "expected_record_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "expected_collection_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "affected_records": {"type": "array", "items": {"type": "string"}},
    "affected_derivatives": {"type": "array", "items": {"type": "object"}},
    "conflicts": {"type": "array", "items": {"type": "object"}},
    "clarifications": {"type": "array", "items": {"type": "object"}},
    "expected_canonical_revision": {"type": "integer", "minimum": 0},
    "expected_canonical_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "changeset_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "approval_state": {"enum": ["PROPOSED", "NEEDS_CLARIFICATION", "REVIEW_READY", "APPROVED", "REJECTED", "COMMITTED"]},
    "approved_at": {"type": ["string", "null"]},
    "approved_by": {"type": ["string", "null"]},
    "commit_event_id": {"type": ["string", "null"]},
    "transaction_id": {"type": ["string", "null"]},
    "committed_at": {"type": ["string", "null"], "format": "date-time"}
  }
}

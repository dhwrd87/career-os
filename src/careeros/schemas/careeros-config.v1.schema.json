{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:careeros:schema:config:v1",
  "title": "CareerOSConfigV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "config_version", "workspace", "candidate", "privacy", "career", "discovery", "qualification", "resume", "applications", "adapters", "runtime"],
  "properties": {
    "schema": {"const": "careeros.config.v1"},
    "config_version": {"const": "1.0.0"},
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_root", "user_data_root", "state_root", "output_root", "cache_root", "locale", "timezone"],
      "properties": {
        "package_root": {"type": "string", "minLength": 1},
        "user_data_root": {"type": "string", "minLength": 1},
        "state_root": {"type": "string", "minLength": 1},
        "output_root": {"type": "string", "minLength": 1},
        "cache_root": {"type": "string", "minLength": 1},
        "locale": {"type": "string", "minLength": 2},
        "timezone": {"type": "string", "minLength": 1}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_path"],
      "properties": {
        "profile_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$"},
        "profile_path": {"type": "string", "minLength": 1},
        "public_identity_policy_path": {"type": ["string", "null"]}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_visibility", "allow_network_enrichment", "allow_sensitive_data_in_logs", "require_human_approval_for_external_actions"],
      "properties": {
        "default_visibility": {"enum": ["PRIVATE", "INTERNAL", "PUBLIC", "EMPLOYER_SAFE", "RESTRICTED"]},
        "source_document_retention": {"enum": ["USER_MANAGED", "SESSION_ONLY", "UNTIL_USER_DELETES"]},
        "generated_artifact_retention_days": {"type": ["integer", "null"]},
        "allow_network_enrichment": {"type": "boolean"},
        "allow_sensitive_data_in_logs": {"type": "boolean"},
        "require_human_approval_for_external_actions": {"const": true}
      }
    },
    "career": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preferences_path", "role_families_path"],
      "properties": {
        "preferences_path": {"type": "string", "minLength": 1},
        "role_families_path": {"type": "string", "minLength": 1},
        "market_map_path": {"type": ["string", "null"]}
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "adapters"],
      "properties": {
        "enabled": {"type": "boolean"},
        "adapters": {"type": "array", "items": {"type": "string"}},
        "freshness_policy": {"type": ["string", "null"]},
        "dedupe_policy": {"type": ["string", "null"]}
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "compensation_is_hard_gate"],
      "properties": {
        "policy": {"type": "string", "minLength": 1},
        "compensation_is_hard_gate": {"type": "boolean"}
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template", "page_target", "renderer", "font_profile", "compact_fallback", "output_naming", "gates"],
      "properties": {
        "template": {"type": "string", "minLength": 1},
        "page_target": {"type": "integer"},
        "renderer": {"type": "string", "minLength": 1},
        "font_profile": {"type": "string", "minLength": 1},
        "compact_fallback": {"type": "boolean"},
        "output_naming": {"type": "string", "minLength": 1},
        "gates": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "applications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_policy", "submitted_artifacts_immutable"],
      "properties": {
        "approval_policy": {"const": "human_before_external_action"},
        "submitted_artifacts_immutable": {"const": true},
        "follow_up_policy": {"type": ["string", "null"]},
        "interview_workflow": {"type": ["string", "null"]}
      }
    },
    "adapters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["email", "calendar", "crm"],
      "properties": {
        "email": {"$ref": "urn:careeros:schema:config-adapter:v1"},
        "calendar": {"$ref": "urn:careeros:schema:config-adapter:v1"},
        "crm": {"$ref": "urn:careeros:schema:config-adapter:v1"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["poppler_bin", "office_converter", "network_timeout_seconds", "log_level"],
      "properties": {
        "poppler_bin": {"type": "string", "minLength": 1},
        "office_converter": {"type": "string", "minLength": 1},
        "network_timeout_seconds": {"type": "integer"},
        "log_level": {"enum": ["debug", "info", "warning", "error"]}
      }
    }
  }
}

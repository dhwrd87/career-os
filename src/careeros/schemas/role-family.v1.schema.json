{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:careeros:schema:role-family:v1",
  "title": "RoleFamilyV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "record_id", "created_at", "updated_at", "provenance", "verification_state", "confidence", "visibility", "status", "family_id", "label", "description", "target_titles", "skill_tags", "evidence_requirements"],
  "properties": {
    "schema": {"const": "careeros.role-family.v1"},
    "schema_version": {"const": "1.0.0"},
    "record_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "urn:careeros:schema:provenance-record:v1"}},
    "verification_state": {"enum": ["UNVERIFIED", "NEEDS_VERIFICATION", "VERIFIED", "DISPUTED"]},
    "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "visibility": {"enum": ["PRIVATE", "INTERNAL", "PUBLIC", "EMPLOYER_SAFE", "RESTRICTED"]},
    "status": {"enum": ["ACTIVE", "SUPERSEDED", "REJECTED"]},
    "supersedes_record_id": {"type": ["string", "null"]},
    "family_id": {"type": "string", "minLength": 1},
    "role_family_id": {"type": "string", "minLength": 1},
    "label": {"type": "string", "minLength": 1},
    "display_name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "headline": {"type": ["string", "null"]},
    "target_titles": {"type": "array", "items": {"type": "string"}},
    "seniority": {"type": "string", "minLength": 1},
    "core_capabilities": {"type": "array", "items": {"type": "string"}},
    "preferred_capabilities": {"type": "array", "items": {"type": "string"}},
    "transferable_capabilities": {"type": "array", "items": {"type": "string"}},
    "hard_requirements": {"type": "array", "items": {"type": "string"}},
    "common_gaps": {"type": "array", "items": {"type": "string"}},
    "evidence_preferences": {"type": "array", "items": {"type": "string"}},
    "resume_strategy": {"type": "string", "minLength": 1},
    "qualification_policy_ref": {"type": "string", "minLength": 1},
    "approval_state": {"enum": ["PROPOSED", "APPROVED", "REJECTED"]},
    "skill_tags": {"type": "array", "items": {"type": "string"}},
    "evidence_requirements": {"type": "array", "items": {"type": "string"}},
    "eligibility_rules": {"type": "array", "items": {"type": "string"}}
  }
}

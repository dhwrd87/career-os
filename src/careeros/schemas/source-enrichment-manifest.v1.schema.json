{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:careeros:schema:source-enrichment-manifest:v1",
  "title": "SourceEnrichmentManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "manifest_id", "created_at", "updated_at",
    "approval_prompted_at", "approval_decided_at", "sources",
    "authorized_source_count", "captured_source_count", "canonical_mutation"
  ],
  "properties": {
    "schema": {"const": "careeros.source-enrichment-manifest.v1"},
    "schema_version": {"const": "1.0.0"},
    "manifest_id": {"type": "string", "pattern": "^source-enrichment:"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "approval_prompted_at": {"type": ["string", "null"], "format": "date-time"},
    "approval_decided_at": {"type": ["string", "null"], "format": "date-time"},
    "authorized_source_count": {"type": "integer", "minimum": 0},
    "captured_source_count": {"type": "integer", "minimum": 0},
    "canonical_mutation": {"const": false},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enrichment_source_id", "source_type", "source_location", "detected_from",
          "capture_time", "source_hash", "records_proposed", "conflicts_found",
          "evidence_blocks_enriched", "candidate_approval_state", "capture_status", "failure"
        ],
        "properties": {
          "enrichment_source_id": {"type": "string", "pattern": "^linked-source:"},
          "source_type": {"enum": ["LINKEDIN", "GITHUB", "PORTFOLIO"]},
          "source_location": {"type": "string", "format": "uri", "pattern": "^https?://"},
          "detected_from": {"type": "string", "minLength": 1},
          "capture_time": {"type": ["string", "null"], "format": "date-time"},
          "source_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "records_proposed": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["record_type", "record_id"],
              "properties": {
                "record_type": {"type": "string"},
                "record_id": {"type": "string"}
              }
            }
          },
          "conflicts_found": {"type": "array", "items": {"type": "string"}},
          "evidence_blocks_enriched": {"type": "array", "items": {"type": "string"}},
          "candidate_approval_state": {"enum": ["PENDING", "APPROVED", "DECLINED"]},
          "capture_status": {"enum": ["NOT_REQUESTED", "DECLINED", "CAPTURED", "FAILED"]},
          "failure": {"type": ["object", "null"]}
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:careeros:schema:credential-record:v1",
  "title": "CredentialRecordV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "record_id", "created_at", "updated_at", "provenance", "verification_state", "confidence", "visibility", "status", "title", "issuer", "credential_state", "claim_boundaries"],
  "properties": {
    "schema": {"const": "careeros.credential-record.v1"},
    "schema_version": {"const": "1.0.0"},
    "record_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "urn:careeros:schema:provenance-record:v1"}},
    "verification_state": {"enum": ["UNVERIFIED", "NEEDS_VERIFICATION", "VERIFIED", "DISPUTED"]},
    "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "visibility": {"enum": ["PRIVATE", "INTERNAL", "PUBLIC", "EMPLOYER_SAFE", "RESTRICTED"]},
    "status": {"enum": ["ACTIVE", "SUPERSEDED", "REJECTED"]},
    "supersedes_record_id": {"type": ["string", "null"]},
    "title": {"type": "string", "minLength": 1},
    "issuer": {"type": "string", "minLength": 1},
    "platform": {"type": ["string", "null"]},
    "credential_state": {"type": "string", "minLength": 1},
    "issued_date": {"type": ["string", "null"]},
    "expiration_date": {"type": ["string", "null"]},
    "credential_identifier": {"type": ["string", "null"]},
    "credential_url": {"type": ["string", "null"]},
    "capability_ids": {"type": "array", "items": {"type": "string"}},
    "claim_boundaries": {"type": "array", "items": {"type": "string"}}
  }
}

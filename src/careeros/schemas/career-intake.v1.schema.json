{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:careeros:schema:career-intake:v1",
  "title": "CareerIntakeCompilerV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "intake_id", "mode", "state", "created_at", "sources", "prefilled_onboarding", "source_claims", "contradictions", "questions", "question_count", "exception_questions", "inference_policy", "canonical_mutation"],
  "properties": {
    "schema": {"const": "careeros.career-intake.v1"},
    "schema_version": {"const": "1.0.0"},
    "intake_id": {"type": "string", "pattern": "^intake:"},
    "mode": {"enum": ["FAST", "DEEP"]},
    "state": {"enum": ["AWAITING_COMPLETION", "EXCEPTION_CLARIFICATION", "COMMIT_PREVIEW_READY"]},
    "created_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "completed_source": {"type": "string"},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "prefilled_onboarding": {"type": "object"},
    "source_claims": {"type": "array", "items": {"type": "object"}},
    "contradictions": {"type": "array", "items": {"type": "string"}},
    "questions": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "urn:careeros:schema:question-value:v1"}},
    "question_count": {"type": "integer", "minimum": 1, "maximum": 20},
    "exception_questions": {"type": "array", "maxItems": 5, "items": {"type": "object"}},
    "inference_policy": {"type": "object"},
    "source_enrichment_manifest": {"type": "string"},
    "linked_source_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detected", "authorized", "captured"],
      "properties": {
        "detected": {"type": "integer", "minimum": 0},
        "authorized": {"type": "integer", "minimum": 0},
        "captured": {"type": "integer", "minimum": 0}
      }
    },
    "evidence_depth_assessments": {"type": "array", "items": {"$ref": "urn:careeros:schema:evidence-depth-assessment:v1"}},
    "evidence_expansion_questions": {"type": "array", "items": {"type": "object"}},
    "evidence_expansion_question_count": {"type": "integer", "minimum": 0},
    "canonical_mutation": {"const": false}
  }
}

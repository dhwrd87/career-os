{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:careeros:schema:question-value:v1",
  "title": "QuestionValueV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "question_id", "section", "prompt", "target_fields", "required", "allows_unknown", "value", "why_asked"],
  "properties": {
    "schema": {"const": "careeros.question-value.v1"},
    "schema_version": {"const": "1.0.0"},
    "question_id": {"type": "string", "minLength": 3},
    "section": {"type": "string", "minLength": 2},
    "prompt": {"type": "string", "minLength": 10},
    "target_fields": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "required": {"type": "boolean"},
    "allows_unknown": {"type": "boolean"},
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["career_value", "target_lane_relevance", "evidence_deficiency", "answerability", "downstream_reuse", "user_effort", "privacy_sensitivity", "score"],
      "properties": {
        "career_value": {"type": "integer", "minimum": 0, "maximum": 3},
        "target_lane_relevance": {"type": "integer", "minimum": 0, "maximum": 3},
        "evidence_deficiency": {"type": "integer", "minimum": 0, "maximum": 3},
        "answerability": {"type": "integer", "minimum": 0, "maximum": 3},
        "downstream_reuse": {"type": "integer", "minimum": 0, "maximum": 3},
        "user_effort": {"type": "integer", "minimum": 0, "maximum": 3},
        "privacy_sensitivity": {"type": "integer", "minimum": 0, "maximum": 3},
        "score": {"type": "number"}
      }
    },
    "why_asked": {"type": "string"}
  }
}
